rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // IMPORTANT: these use direct field access (workspaceData.field), never
    // resource.data.get(field, default). Firestore's list-query provability
    // checker cannot validate a query against a rule that uses .get() with a
    // default - it silently denies the entire query even when the query's
    // own filter guarantees the condition, and even with no other
    // conditions combined. Confirmed by direct testing against the live
    // project. Every workspace document is always written with all of
    // memberIds/members/memberRoles/pendingInviteEmails present together
    // (see WorkspaceMembership.createWorkspace), so direct access is safe.
    function isMember(workspaceData) {
      return isSignedIn() && request.auth.uid in workspaceData.memberIds;
    }

    function isInvitedByEmail(workspaceData) {
      return isSignedIn() &&
        request.auth.token.email in workspaceData.pendingInviteEmails;
    }

    function isLegacyMemberByEmail(workspaceData) {
      return isSignedIn() &&
        request.auth.token.email in workspaceData.members;
    }

    function isAdmin(workspaceData) {
      return isMember(workspaceData) &&
        workspaceData.memberRoles[request.auth.uid] == 'admin';
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(resource.data)
        || isLegacyMemberByEmail(resource.data)
        || isInvitedByEmail(resource.data);

      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;

      // Update covers normal member activity (categories, targets, invites)
      // plus "self-join" writes: accepting an invite or redeeming an invite
      // code both add the caller to memberIds/memberRoles before they are a
      // member, so the check also passes if the caller is a member *after*
      // the write, so long as no existing member is removed in the process.
      allow update: if isMember(resource.data) || (
        isMember(request.resource.data) &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds)
      ) || (
        // Declining an invite: only pendingInviteEmails may change.
        isInvitedByEmail(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInviteEmails'])
      );

      allow delete: if isAdmin(resource.data);

      match /transactions/{transactionId} {
        allow read, write: if isMember(
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data);
      }
    }

    // Maps a short invite code to its workspace so a not-yet-member can
    // resolve a code without being able to read the workspace's data.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly(['workspaceId'])
        && request.resource.data.workspaceId is string;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
