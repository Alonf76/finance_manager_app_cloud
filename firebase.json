{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "alon-finance-final",
          "appId": "1:816830288773:android:8b2ba40cd60b29eb682aec",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "alon-finance-final",
          "configurations": {
            "android": "1:816830288773:android:8b2ba40cd60b29eb682aec",
            "ios": "1:816830288773:ios:98c6d944231cc018682aec",
            "macos": "1:816830288773:ios:98c6d944231cc018682aec",
            "web": "1:816830288773:web:440747784ec373be682aec",
            "windows": "1:816830288773:web:50a927496c48439a682aec"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
