rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is a member of the workspace
    function isMember(workspaceData) {
      return request.auth != null && request.auth.uid in workspaceData.memberIds;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(resource.data);
      allow create: if request.auth != null;
      allow update, delete: if isMember(resource.data) && resource.data.memberRoles[request.auth.uid] == 'admin';

      match /transactions/{transactionId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data);
      }
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}